# .vercelignore — Files Vercel does not need to build the app. The build (npm run build) makes the
# front end and bundles server.ts + server/ into one function (scripts/build-vercel.mjs), so the
# server code IS uploaded; only documents, backups and local secrets stay out.
docs/
backups/
supabase/
PROMPT_*.md
.env
.env.*
!.env.example
