# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOLD_API_KEY: Optional API key for GoldAPI.io (server automatically uses public XAU spot endpoint if omitted).
GOLD_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Finnhub free API key (https://finnhub.io/register) for real-time US stock trades over
# WebSocket. Used on the server only — never sent to the browser. Leave empty to use Yahoo (±5 s).
FINNHUB_API_KEY=

# ---- Stage 3 (all optional: every feature works without them, in a limited local-only form) ----

# Sync between devices + server AI forward test: a free Supabase project (Settings → API).
# Create the table with the SQL in README ("Sync between devices"). Server only — never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Owner passphrase for logging in to sync (at least 8 characters). Changing it logs out every device.
SYNC_PASSPHRASE=
# Optional separate signing secret for session tokens (default: derived from SYNC_PASSPHRASE).
SYNC_SESSION_SECRET=
# Protects POST /api/cron/daily (send "Authorization: Bearer <CRON_TOKEN>" from Cloud Scheduler / cron-job.org).
CRON_TOKEN=
# Development only: keep synced data in server memory (lost on restart) to try sync without a database.
SYNC_DEV_MEMORY_DB=
# Web push for alerts and the morning brief (also needs the database and SYNC_PASSPHRASE above).
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
